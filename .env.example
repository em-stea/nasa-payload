# Local Mongo (docker compose up -d starts one on this port)
DATABASE_URL=mongodb://127.0.0.1:27017/nasa-backoffice

# Secret used to sign Payload session tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Origins allowed to call the comments REST API, comma-separated
CORS_ORIGINS=http://localhost:3001

# Origins allowed to use the session cookie (admin + blog).
# Must include the admin origin; otherwise drawers/replies fail with Unauthorized.
CSRF_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth.js (NextAuth) -------------------------------------------------------
# Secret used to sign the session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Required outside Vercel so Auth.js trusts the request host.
AUTH_TRUST_HOST=true

# Google Cloud Console > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub > Settings > Developer settings > OAuth Apps.
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Front (Zod in src/shared/config/front-config.ts) -------------------------
NEXT_PUBLIC_ENVIRONMENT=development

# --- NASA Open APIs ----------------------------------------------------------
# api.nasa.gov key, used by the asteroid catalog (NeoWs), the home page's
# near-misses feed and TechPort missions.
# Free at https://api.nasa.gov. Required: without it the project won't start
# (validated by src/shared/config/front-config.ts).
NEXT_PUBLIC_NASA_API_KEY=
