# Mongo local (docker compose up -d levanta uno en este puerto)
DATABASE_URL=mongodb://127.0.0.1:27017/nasa-backoffice

# Clave para firmar los tokens de Payload. Generá una con: openssl rand -hex 32
PAYLOAD_SECRET=cambiame

# Orígenes del blog que consumen la API de comentarios, separados por coma
CORS_ORIGINS=http://localhost:3001

# Orígenes que pueden usar la cookie de sesión (admin + blog).
# Debe incluir el origen del admin; si no, drawers/respuestas fallan con Unauthorized.
CSRF_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth.js (NextAuth) -------------------------------------------------------
# Clave para firmar el JWT de sesión. Generá una con: openssl rand -base64 32
AUTH_SECRET=cambiame

# Necesario fuera de Vercel para que Auth.js confíe en el host del request.
AUTH_TRUST_HOST=true

# Google Cloud Console > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub > Settings > Developer settings > OAuth Apps.
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- NASA Open APIs ----------------------------------------------------------
# Clave de api.nasa.gov, que usa el catálogo de asteroides (NeoWs).
# Se saca gratis en https://api.nasa.gov. Sin ella se cae a DEMO_KEY, que corta
# a 30 requests por hora y por IP.
NASA_API_KEY=
