# Mongo local (docker compose up -d levanta uno en este puerto)
DATABASE_URL=mongodb://127.0.0.1:27017/nasa-backoffice

# Clave para firmar los tokens de Payload. Generá una con: openssl rand -hex 32
PAYLOAD_SECRET=cambiame

# Orígenes del blog que consumen la API de comentarios, separados por coma
CORS_ORIGINS=http://localhost:3001

# Orígenes que pueden usar la cookie de sesión (admin + blog).
# Debe incluir el origen del admin; si no, drawers/respuestas fallan con Unauthorized.
CSRF_ORIGINS=http://localhost:3000,http://localhost:3001
