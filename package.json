{
  "name": "nasa-backoffice",
  "version": "0.1.0",
  "description": "Backoffice de comentarios para el blog de noticias de la NASA",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "cross-env": "^7.0.3",
    "embla-carousel-react": "^8.6.0",
    "globe.gl": "^2.46.2",
    "graphql": "^16.8.1",
    "lite-youtube-embed": "^0.3.4",
    "lucide-react": "^1.41.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "payload": "3.88.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.5",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "playwright": "latest",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.83.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
